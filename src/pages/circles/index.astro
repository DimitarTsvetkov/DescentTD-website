---
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Sprite from '../../components/Sprite.astro';
import keyart from '../../assets/game/hero/keyart.webp';
import { circles, circleSlug } from '../../data/circles';
import { circlePages } from '../../data/circlePages';
import { site } from '../../data/site';

const art = import.meta.glob<{ default: ImageMetadata }>('../../assets/game/circles/*/*.webp', { eager: true });
const img = (n: number, file: string) => art[`../../assets/game/circles/c${n}/${file}.webp`].default;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: 'The Circles', item: `${site.url}/circles/` },
      ],
    },
    {
      '@type': 'ItemList',
      name: 'The nine circles of hell in DescentTD',
      itemListElement: circles.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        url: `${site.url}/circles/${circleSlug(c)}/`,
      })),
    },
  ],
};
---

<Base
  title="The Nine Circles of Hell"
  description="The nine circles of hell from Dante’s poem, as a hand-painted tower defense comedy: every circle’s souls, bosses, hazards and jokes, from Limbo down to the frozen Center."
  jsonLd={jsonLd}
>
  <section class="ci-hero">
    <Picture src={keyart} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[640, 1280, 1672]} sizes="100vw" alt="" class="ci-hero__bg" loading="eager" />
    <div class="ci-hero__shade" aria-hidden="true"></div>
    <div class="wrap ci-hero__content">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={`${base}/`}>Home</a> <span aria-hidden="true">›</span> <span aria-current="page">The Circles</span>
      </nav>
      <p class="eyebrow">The descent</p>
      <h1 class="ci-hero__title">The nine circles of hell</h1>
      <p class="ci-hero__lede">
        In Dante’s poem, the underworld is a funnel of nine circles, each one deeper and each one for a different sin. In
        DescentTD, every circle is its own little game: new scenery, new souls, a new hazard and a boss who is funny right
        up until he isn’t. Pick a circle, or start at the top and descend.
      </p>
    </div>
  </section>

  <section class="wrap ci-list" aria-label="Circles">
    <ol class="ci-grid">
      {
        circles.map((c) => {
          const page = circlePages.find((p) => p.n === c.n)!;
          const soul = page.souls[0]?.sprite;
          return (
            <li class:list={['ci-card', { 'ci-card--center': c.n === 10 }]} style={`--c:${c.colour}`}>
              <a href={`${base}/circles/${circleSlug(c)}/`} class="ci-card__link">
                <Image src={img(c.n, 'backdrop')} widths={[480, 800]} sizes="(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 92vw" alt="" class="ci-card__img" />
                <span class="ci-card__numeral" aria-hidden="true">{c.numeral}</span>
                {soul && (
                  <span class="ci-card__soul" aria-hidden="true">
                    <Sprite id={soul} scale={0.45} />
                  </span>
                )}
                <span class="ci-card__body">
                  <span class="ci-card__meta">{c.n === 10 ? 'Level 91' : `Circle ${c.numeral} · Levels ${c.levels}`}</span>
                  <span class="ci-card__name">{c.name}</span>
                  <span class="ci-card__line">{c.line}</span>
                  <span class="ci-card__boss">Boss: {c.boss}</span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>
</Base>

<style>
  .ci-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 62svh;
    display: grid;
    align-items: end;
  }

  .ci-hero :global(.ci-hero__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 40% 35%;
  }

  .ci-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(18 20 28 / 0.7), transparent 30%),
      linear-gradient(0deg, var(--bg) 5%, rgb(18 20 28 / 0.82) 45%, rgb(18 20 28 / 0.35));
  }

  .ci-hero__content {
    padding: calc(var(--header-h) + 3rem) 0 2.5rem;
  }

  .crumbs {
    margin-bottom: 1rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .crumbs a {
    color: var(--ink-soft);
    text-decoration: none;
  }

  .ci-hero__title {
    font-size: var(--step-4);
  }

  .ci-hero__lede {
    max-width: 44rem;
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  .ci-list {
    padding: 1.5rem 0 5rem;
  }

  .ci-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ci-card__link {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 340px;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  }

  .ci-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, rgb(10 11 16 / 0.96) 8%, rgb(10 11 16 / 0.55) 48%, transparent 80%);
  }

  .ci-card__link :global(.ci-card__img) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }

  .ci-card__link:hover,
  .ci-card__link:focus-visible {
    color: var(--ink);
    transform: translateY(-4px);
    border-color: var(--c);
    box-shadow: 0 18px 50px color-mix(in srgb, var(--c) 35%, transparent);
  }

  .ci-card__link:hover :global(.ci-card__img) {
    transform: scale(1.07);
  }

  .ci-card__numeral {
    position: absolute;
    top: 0.6rem;
    left: 1rem;
    font-family: var(--font-hand);
    font-size: 4rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in srgb, var(--c) 60%, white);
    opacity: 0.85;
  }

  .ci-card__soul {
    position: absolute;
    right: 0.8rem;
    top: 30%;
    opacity: 0;
    transform: translateX(20px);
    transition: opacity 0.35s ease, transform 0.35s ease;
    filter: drop-shadow(0 8px 8px rgb(0 0 0 / 0.6));
  }

  .ci-card__soul :global(.sprite) {
    animation-play-state: paused;
  }

  .ci-card__link:hover .ci-card__soul {
    opacity: 1;
    transform: none;
  }

  .ci-card__link:hover .ci-card__soul :global(.sprite) {
    animation-play-state: running;
  }

  .ci-card__body {
    display: grid;
    gap: 0.2rem;
    padding: 1.2rem 1.3rem 1.3rem;
  }

  .ci-card__meta {
    font-size: var(--step--1);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c) 55%, white);
  }

  .ci-card__name {
    font-family: var(--font-hand);
    font-size: var(--step-3);
    line-height: 1.05;
  }

  .ci-card__line {
    color: var(--ink-soft);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ci-card__boss {
    margin-top: 0.3rem;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--gold);
  }

  @media (min-width: 1100px) {
    .ci-card--center {
      grid-column: 1 / -1;
    }

    .ci-card--center .ci-card__link {
      min-height: 380px;
    }
  }
</style>
