---
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="wrap footer__inner">
    <div>
      <p class="footer__name">{site.name}</p>
      <p class="footer__contact">
        Questions or a level that feels unfair?<br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer__links">
        <li><a href={`${base}/support/`}>Support</a></li>
        <li><a href={`${base}/privacy/`}>Privacy</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap footer__legal">
    <p>© {site.year} {site.developer}. All rights reserved.</p>
    <p>{site.attribution}</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 2;
    padding: 3rem 0 calc(6rem + env(safe-area-inset-bottom));
    background: #0b0c12;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .footer__name {
    font-family: var(--font-hand);
    font-size: var(--step-1);
    color: var(--ink);
    margin-bottom: 0.4em;
  }

  .footer__links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
  }

  .footer__links a {
    display: inline-block;
    padding: 0.5rem 0;
  }

  .footer__legal {
    margin-top: 2rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    color: var(--ink-mute);
  }

  .footer__legal p {
    margin: 0 0 0.3em;
  }

  @media (min-width: 861px) {
    .footer {
      padding-bottom: 3rem;
    }
  }
</style>
