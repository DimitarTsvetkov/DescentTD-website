---
import { Picture } from 'astro:assets';
import stars from '../assets/game/ending/stars.webp';
import Sprite from './Sprite.astro';
import StoreBadges from './StoreBadges.astro';
---

<section id="play" class="cta" aria-labelledby="cta-title">
  <Picture src={stars} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[640, 1200, 2048]} sizes="100vw" alt="" class="cta__bg" />
  <div class="cta__shade" aria-hidden="true"></div>

  <div class="cta__inner wrap">
    <div class="cta__text">
      <p class="eyebrow">The climb out</p>
      <h2 id="cta-title" class="cta__title">Free. The whole story. Forever.</h2>
      <p class="cta__lede">All 91 levels, every tower and the ending, with no ads and nothing to buy to finish it.</p>
      <StoreBadges size="lg" />
    </div>
    <div class="cta__pair" aria-hidden="true">
      <Sprite id="virgil-lookup" scale={0.78} />
      <Sprite id="dante-lookup" scale={0.78} />
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4rem, 12vw, 9rem) 0 0;
  }

  .cta :global(.cta__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .cta__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, var(--bg-2) 0%, transparent 25%),
      linear-gradient(0deg, rgb(11 12 18) 0%, transparent 35%);
  }

  .cta__inner {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .cta__text {
    text-align: center;
    display: grid;
    justify-items: center;
  }

  .cta__title {
    font-size: var(--step-4);
    text-shadow: 0 4px 24px rgb(0 0 0 / 0.7);
  }

  .cta__lede {
    font-size: var(--step-1);
    max-width: 32ch;
    text-shadow: 0 2px 12px rgb(0 0 0 / 0.8);
    margin-bottom: 1.5rem;
  }

  .cta__pair {
    display: flex;
    justify-content: center;
    align-items: end;
    gap: 0.5rem;
  }

  .cta__pair :global(.sprite) {
    filter: drop-shadow(0 10px 12px rgb(0 0 0 / 0.5));
  }

  @media (min-width: 900px) {
    .cta__inner {
      grid-template-columns: 1.2fr 1fr;
    }

    .cta__text {
      text-align: left;
      justify-items: start;
      padding-bottom: 6rem;
    }
  }
</style>
